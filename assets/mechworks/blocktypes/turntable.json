{
	code: "turntable",
	class: "MechworksTurntable",
	entityClass: "MechworksTurntable",
	// Vanilla mechanical power hookup. mechPartShape: null is mandatory — see piston.json.
	entityBehaviors: [{ name: "MPConsumer", properties: { resistance: 0.5, mechPartShape: null } }],
	creativeinventory: { "general": ["*"], "mechanics": ["*"] },
	drawtype: "json",
	// Vanilla assets all live under the "game" domain whatever folder they sit in.
	// Referenced the same way as piston.json and pistonbeam.json, the two custom-model
	// blocks that render correctly. Plain "shape" was the one untried combination.
	shapebytype: {
		"*": { base: "block/turntable" }
	},
	textures: {
		wood: { base: "game:block/wood/planks/generic" },
		metal: { base: "game:block/metal/plate/iron" }
	},
	blockmaterial: "Wood",
	resistance: 3.5,
	lightAbsorption: 0,
	maxStackSize: 8,
	sideOpaque: { all: false },
	sidesolid: { all: false },
	sounds: {
		hit: "game:block/planks",
		break: "game:block/planks",
		place: "game:block/planks",
		walk: "game:walk/wood"
	}
}
