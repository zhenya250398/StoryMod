{
	code: "piston",
	class: "MechworksPiston",
	entityClass: "MechworksPiston",
	behaviors: [{ name: "HorizontalOrientable" }],
	// Vanilla mechanical power hookup — registered by VSSurvivalMod, no code needed.
	//
	// mechPartShape: null is required, not decorative. Without it MPConsumer falls back
	// to Block.Shape and hands it to the rotating-parts renderer, which cannot tesselate
	// a plain cube and dies with a NullReferenceException on placement. MechNetworkRenderer
	// .AddDevice() early-returns on a null shape, which is how vanilla quern and
	// grindingwheel opt out. Set this to a real shape only once the piston has a
	// spinning part worth drawing.
	entityBehaviors: [{ name: "MPConsumer", properties: { resistance: 0.3, mechPartShape: null } }],
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	drawtype: "json",
	// Asset paths resolve against THIS file's domain (mechworks), so vanilla assets must
	// name theirs. That domain is "game" for all of them: the base game keeps assets in
	// game/, survival/ and creative/ folders, but registers the lot under one domain.
	// Unqualified paths silently resolve to mechworks:... and render white.
	// The shape is modelled facing east; rotateY turns it to the variant's side.
	shapebytype: {
		"*-east":  { base: "block/piston", rotateY: 0 },
		"*-south": { base: "block/piston", rotateY: 90 },
		"*-west":  { base: "block/piston", rotateY: 180 },
		"*-north": { base: "block/piston", rotateY: 270 }
	},
	textures: {
		wood: { base: "game:block/wood/planks/generic" },
		metal: { base: "game:block/metal/plate/iron" },
		beam: { base: "game:block/wood/debarked/oak" }
	},
	sideOpaque: { all: false },
	sidesolid: { all: false },
	blockmaterial: "Wood",
	resistance: 3.5,
	lightAbsorption: 0,
	maxStackSize: 8,
	// All four rotations drop the same item; orientation is chosen on placement.
	drops: [
		{ type: "block", code: "piston-north", quantity: { avg: 1 } }
	],
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	tpHandTransform: {
		translation: { x: -1.23, y: -0.91, z: -0.8 },
		rotation: { x: -2, y: 25, z: -78 },
		scale: 0.4
	},
	sounds: {
		hit: "game:block/planks",
		break: "game:block/planks",
		place: "game:block/planks",
		walk: "game:walk/wood"
	}
}
